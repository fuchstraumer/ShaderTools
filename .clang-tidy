---
# The Checks list dictates what rules are active. 
# It starts by disabling everything (-*), then selectively enabling groups.
Checks: >
    -*,
    bugprone-*,
    performance-*,
    modernize-*,
    cppcoreguidelines-*,
    readability-identifier-naming,
    -modernize-use-trailing-return-type,
    -cppcoreguidelines-avoid-magic-numbers,
    -cppcoreguidelines-avoid-c-arrays,
    -modernize-avoid-c-arrays

WarningsAsErrors: ''
# Only check headers from src/, include/, client/, tests/ - explicitly exclude third_party
HeaderFilterRegex: '^(?!.*third_party).*(src|include|client|tests)/.*'

CheckOptions:
    misc-include-cleaner.IgnoreHeaders: 'third_party/.*'
    misc-include-cleaner.UnusedIncludes: true

    # --- Types (CamelCase) ---
    readability-identifier-naming.ClassCase: CamelCase
    readability-identifier-naming.StructCase: CamelCase
    readability-identifier-naming.EnumCase: CamelCase
    readability-identifier-naming.EnumConstantCase: CamelCase
    readability-identifier-naming.UnionCase: CamelCase
    readability-identifier-naming.TypeAliasCase: CamelCase
    readability-identifier-naming.TypedefCase: CamelCase

    # --- Variables and Members ---
    # Public / Local
    readability-identifier-naming.VariableCase: CamelCase
    readability-identifier-naming.PublicMemberCase: CamelCase
    readability-identifier-naming.PublicMethodCase: CamelCase
    readability-identifier-naming.GlobalVariableCase: CamelCase
    # Private / Protected
    readability-identifier-naming.PrivateMemberCase: camelBack
    readability-identifier-naming.ProtectedMemberCase: camelBack

    # --- Functions and Methods ---
    # Public / Default
    readability-identifier-naming.FunctionCase: CamelCase
    readability-identifier-naming.MethodCase: CamelCase
    # Private / Protected
    readability-identifier-naming.PrivateMethodCase: camelBack
    readability-identifier-naming.ProtectedMethodCase: camelBack

    # --- Parameters (lower_case) ---
    readability-identifier-naming.ParameterCase: lower_case
    readability-identifier-naming.LocalVariableCase: camelBack